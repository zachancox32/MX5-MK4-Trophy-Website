---
layout: base.njk
title: "MX-5 Mk4 Trophy | One make Mazda MX-5 racing with the BRSCC"
description: "The MX-5 Mk4 Trophy runs with the BRSCC across seven UK circuits. Identical Mk4 Mazda MX-5s, sealed to the same spec, so the result comes down to the driver. Calendar, standings and how to get on the grid."
ogTitle: "MX-5 Mk4 Trophy"
ogDescription: "Seven rounds. One spec. Identical Mk4 Mazda MX-5s across seven UK circuits with the BRSCC."
permalink: /index.html
---
<!-- ============================================================ hero -->
  <section class="hero">
    <div class="shell hero__in">
      <div>
        <p class="eyebrow">2026 season &middot; BRSCC club racing</p>
        <h1>
          <span>Seven rounds.</span>
          <span class="accent">One spec.</span>
        </h1>
        <p class="hero__lede">The MX-5 Mk4 Trophy runs with the BRSCC across seven UK circuits. Identical Mk4 Mazda MX-5s, sealed to the same spec, so the result comes down to the driver and nothing else.</p>
        <div class="hero__cta">
          <a class="btn btn--lg" href="#enquire">Get on the grid</a>
          <a class="btn btn--lg btn--ghost" href="#calendar">See the 2026 calendar</a>
        </div>
        <p class="credential">
          <span>Racing with</span>
          <a href="https://brscc.co.uk/" rel="noopener">
            <img src="/assets/brand/brscc-logo.png" alt="British Racing and Sports Car Club" width="300" height="76">
          </a>
        </p>
      </div>

      <!-- filled in by js/main.js from the calendar below; this markup is the
           fallback shown if JavaScript never runs -->
      <div class="next" id="next-round" data-next-card>
        <div class="next__top">
          <p class="eyebrow" data-next-label>Next round</p>
          <span class="next__count" data-next-count hidden></span>
        </div>
        <h2 class="next__ct" data-next-circuit>The 2026 season</h2>
        <p class="next__date" data-next-date>Seven rounds, April to October</p>
        <dl class="next__facts">
          <div><dt>Races</dt><dd class="num">2</dd></div>
          <div><dt>Entries</dt><dd class="num">[00]</dd></div>
          <div><dt>Round</dt><dd class="num" data-next-index>7</dd></div>
        </dl>
        <a class="lnk" href="#calendar">Full calendar</a>
      </div>
    </div>
  </section>

  <!-- ========================================================== ticker -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker__track" data-ticker>
      <span>MX-5 Mk4 Trophy</span><span>&frasl;</span>
      <span>Seven rounds, one spec</span><span>&frasl;</span>
      <span>Racing with the BRSCC</span><span>&frasl;</span>
      <span>MX-5 Mk4 Trophy</span><span>&frasl;</span>
      <span>Seven rounds, one spec</span><span>&frasl;</span>
      <span>Racing with the BRSCC</span><span>&frasl;</span>
    </div>
  </div>

  <!-- ======================================================== calendar -->
  <section class="band" id="calendar">
    <div class="shell">
      <div class="band__head reveal">
        <div>
          <p class="eyebrow">The season</p>
          <h2>2026 calendar</h2>
        </div>
      </div>

      <!-- Round dates follow the BRSCC Mazda MX-5 SuperCup 2026 calendar.
           To update: edit the data-start / data-end attributes and the text.
           The "next round" highlight and the hero card work these out on load. -->
      <div class="cal reveal" data-calendar>
        <div class="cal__row" data-round="1" data-start="2026-04-18" data-end="2026-04-19">
          <span class="cal__no num">01</span>
          <span class="cal__ct">Snetterton</span>
          <span class="cal__loc">Norfolk</span>
          <span class="cal__dt num">18 to 19 Apr</span>
          <span class="pill" data-status>Results</span>
        </div>
        <div class="cal__row" data-round="2" data-start="2026-05-09" data-end="2026-05-09">
          <span class="cal__no num">02</span>
          <span class="cal__ct">Oulton Park</span>
          <span class="cal__loc">Cheshire</span>
          <span class="cal__dt num">9 May</span>
          <span class="pill" data-status>Results</span>
        </div>
        <div class="cal__row" data-round="3" data-start="2026-06-06" data-end="2026-06-07">
          <span class="cal__no num">03</span>
          <span class="cal__ct">Donington Park</span>
          <span class="cal__loc">Leicestershire</span>
          <span class="cal__dt num">6 to 7 Jun</span>
          <span class="pill" data-status>Results</span>
        </div>
        <div class="cal__row" data-round="4" data-start="2026-07-11" data-end="2026-07-12">
          <span class="cal__no num">04</span>
          <span class="cal__ct">Croft</span>
          <span class="cal__loc">North Yorkshire</span>
          <span class="cal__dt num">11 to 12 Jul</span>
          <span class="pill" data-status>Results</span>
        </div>
        <div class="cal__row" data-round="5" data-start="2026-08-08" data-end="2026-08-09">
          <span class="cal__no num">05</span>
          <span class="cal__ct">Cadwell Park</span>
          <span class="cal__loc">Lincolnshire</span>
          <span class="cal__dt num">8 to 9 Aug</span>
          <span class="pill" data-status>Results</span>
        </div>
        <div class="cal__row" data-round="6" data-start="2026-09-12" data-end="2026-09-13">
          <span class="cal__no num">06</span>
          <span class="cal__ct">Anglesey</span>
          <span class="cal__loc">Isle of Anglesey</span>
          <span class="cal__dt num">12 to 13 Sep</span>
          <span class="pill" data-status>Upcoming</span>
        </div>
        <div class="cal__row" data-round="7" data-start="2026-10-10" data-end="2026-10-11" data-finale>
          <span class="cal__no num">07</span>
          <span class="cal__ct">Silverstone</span>
          <span class="cal__loc">Northamptonshire</span>
          <span class="cal__dt num">10 to 11 Oct</span>
          <span class="pill" data-status>Finale</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================= standings -->
  <section class="band band--dark" id="standings">
    <div class="shell">
      <div class="band__head reveal">
        <div>
          <p class="eyebrow" data-standings-after>Championship</p>
          <h2>Championship standings</h2>
        </div>
      </div>

      <!-- TODO: replace with real names, teams and points after each round -->
      <div class="tablewrap reveal">
        <table class="table">
          <caption class="vh">Drivers championship, top five</caption>
          <thead>
            <tr>
              <th scope="col">Pos</th><th scope="col">No</th><th scope="col">Driver</th>
              <th scope="col">Team</th><th scope="col" style="text-align:center">Wins</th>
              <th scope="col" style="text-align:right">Pts</th>
            </tr>
          </thead>
          <tbody>
            <tr><td class="pos num">1</td><td class="car num">44</td><td class="nm">[Driver name]</td><td class="team">[Team]</td><td class="w num">4</td><td class="pts num">213</td></tr>
            <tr><td class="pos num">2</td><td class="car num">7</td><td class="nm">[Driver name]</td><td class="team">[Team]</td><td class="w num">2</td><td class="pts num">198</td></tr>
            <tr><td class="pos num">3</td><td class="car num">19</td><td class="nm">[Driver name]</td><td class="team">[Team]</td><td class="w num">2</td><td class="pts num">176</td></tr>
            <tr><td class="pos num">4</td><td class="car num">3</td><td class="nm">[Driver name]</td><td class="team">[Team]</td><td class="w num">1</td><td class="pts num">154</td></tr>
            <tr><td class="pos num">5</td><td class="car num">88</td><td class="nm">[Driver name]</td><td class="team">[Team]</td><td class="w num">1</td><td class="pts num">141</td></tr>
          </tbody>
        </table>
      </div>
      <p class="footnote">Placeholder standings. Names, teams and points to be filled in from the BRSCC results.</p>
    </div>
  </section>

  <!-- ========================================================= the car -->
  <section class="band" id="car">
    <div class="shell">
      <div class="car reveal">
        <div>
          <p class="eyebrow" style="color:var(--red-ink);margin-bottom:9px">The car</p>
          <h2 style="font-size:clamp(27px,4.4vw,36px);margin-bottom:14px">One spec. Sealed. Scrutineered.</h2>
          <p style="color:var(--grit-2);margin:0;max-width:46ch">Every car on the grid is a Mk4 Mazda MX-5 built to the same control specification. No development race, no budget arms race. What you bring is setup, tyre management and the ability to overtake.</p>
          <ul class="spec">
            <li><span class="k">Chassis</span><span class="v">Mazda MX-5 Mk4, ND</span></li>
            <li><span class="k">Engine</span><span class="v">[Capacity], sealed</span></li>
            <li><span class="k">Power</span><span class="v">[000] bhp</span></li>
            <li><span class="k">Tyre</span><span class="v">Goodyear, [compound]</span></li>
            <li><span class="k">Safety</span><span class="v">[Cage and seat spec]</span></li>
          </ul>
        </div>
        <!-- TODO: swap for a real photo:
             <img src="/assets/img/car-on-track.jpg" alt="An MX-5 Mk4 Trophy car on track" width="900" height="600"> -->
        <div class="imgph car__media"><span>Photo<br>Mk4 MX-5, three quarter front, on track</span></div>
      </div>
    </div>
  </section>

  <!-- ==================================================== race with us -->
  <section class="band band--dark" id="race">
    <div class="shell">
      <div class="band__head reveal">
        <div>
          <p class="eyebrow">Race with us</p>
          <h2>From licence to grid in three steps</h2>
        </div>
      </div>
      <div class="steps reveal">
        <div class="step">
          <span class="step__n">01</span>
          <h3>Get your licence</h3>
          <p>An ARDS test and an MSUK National licence. One day at a circuit, and most people pass first time.</p>
        </div>
        <div class="step">
          <span class="step__n">02</span>
          <h3>Buy or hire a car</h3>
          <p>Arrive and drive from [£0,000] a weekend, or buy a built car. <a href="/teams/">Teams are being confirmed</a>.</p>
        </div>
        <div class="step">
          <span class="step__n">03</span>
          <h3>Enter the season</h3>
          <p>Full season entry or single rounds. We will walk you through the BRSCC paperwork.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================= driver conversion -->
  <section class="cta">
    <div class="shell cta__in">
      <div>
        <h2>Tell us where you are and we will tell you what it takes.</h2>
        <p>No obligation. A phone call, an honest budget, and an introduction to a team with a seat free.</p>
      </div>
      <a class="btn btn--lg btn--ink" href="#enquire">Enquire about a seat</a>
    </div>
  </section>

  <section class="band band--deep" id="enquire">
    <div class="shell">
      <div class="partner reveal">
        <div>
          <p class="eyebrow" style="color:var(--yellow);margin-bottom:9px">Driver enquiry</p>
          <h2 style="font-size:clamp(27px,4.4vw,36px);margin-bottom:14px">Get on the grid.</h2>
          <p style="color:#A8A89E;margin:0;max-width:46ch">Whether you already hold a licence or you have never sat in a race car, tell us where you are and we will be straight with you about what a season costs and what it takes.</p>
          <ul class="packs">
            <li><span class="pk">New to racing</span><span class="pd">We will point you at an ARDS test and a team who will run you for a test day first.</span></li>
            <li><span class="pk">Licence held</span><span class="pd">Arrive and drive for a single round, or a full season entry.</span></li>
            <li><span class="pk">Own car</span><span class="pd">We will check your build against the technical regulations before you commit.</span></li>
          </ul>
        </div>

        <form class="form" name="driver-enquiry" method="POST" data-netlify="true" netlify-honeypot="company-website" action="/thanks/">
          <input type="hidden" name="form-name" value="driver-enquiry">
          <p class="hp"><label>Leave this empty <input name="company-website" tabindex="-1" autocomplete="off"></label></p>

          <h3>Driver enquiry</h3>
          <p class="form__note">We come back to everyone within [two working days].</p>

          <div class="row2">
            <label class="field"><span>Name</span><input type="text" name="name" autocomplete="name" required></label>
            <label class="field"><span>Phone</span><input type="tel" name="phone" autocomplete="tel"></label>
          </div>
          <label class="field"><span>Email</span><input type="email" name="email" autocomplete="email" required></label>
          <label class="field"><span>Where are you now</span>
            <select name="stage">
              <option>New to racing, no licence</option>
              <option>Doing my ARDS test</option>
              <option>Licence held, no car</option>
              <option>I have a car already</option>
            </select>
          </label>
          <label class="field"><span>Anything else</span><textarea name="message" rows="3"></textarea></label>
          <button class="btn btn--lg btn--block" type="submit">Send enquiry</button>
          <p class="form__legal">We will only use your details to answer this enquiry.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- ======================================================== partners -->
  <section class="band" id="partners">
    <div class="shell">
      <div class="band__head reveal">
        <div>
          <p class="eyebrow">Series partners</p>
          <h2>Who backs the Cup</h2>
        </div>
        <a class="lnk" href="#partner-enquiry">Partner with us</a>
      </div>

      <div class="plogos reveal">
        <a class="ptile" href="https://www.goodyear.eu/en_gb/consumer.html" rel="noopener">
          <img src="/assets/brand/partners/goodyear-blue.png" alt="Goodyear, championship tyre partner"
               width="760" height="228" loading="lazy">
        </a>
        <a class="ptile" href="https://www.thermalroadrepairs.com/" rel="noopener">
          <img src="/assets/brand/partners/thermal-road-repairs.png" alt="Thermal Road Repairs"
               width="1749" height="630" loading="lazy">
        </a>
        <a class="ptile" href="https://www.admodular.com/" rel="noopener">
          <img class="is-tall" src="/assets/brand/partners/ad-modular.png" alt="AD Modular"
               width="300" height="147" loading="lazy">
        </a>
        <a class="ptile ptile--open" href="#partner-enquiry"><b>This space<br>is available</b></a>
      </div>
    </div>
  </section>

  <section class="band band--dark" id="partner-enquiry">
    <div class="shell">
      <div class="partner reveal">
        <div>
          <p class="eyebrow" style="color:var(--yellow);margin-bottom:9px">Partner with us</p>
          <h2 style="font-size:clamp(27px,4.4vw,36px);margin-bottom:14px">Put your brand on the grid.</h2>
          <p style="color:#A8A89E;margin:0;max-width:46ch">Seven weekends, a paddock that trades with itself, and a grid that people stay to watch. Tell us what you want out of it and we will build the package around that rather than sell you a tier.</p>
          <ul class="packs">
            <li><span class="pk">Car livery</span><span class="pd">Your brand on [n] cars for the season, or a single car for one round.</span></li>
            <li><span class="pk">Series rights</span><span class="pd">Title and presenting partner positions, including the championship name.</span></li>
            <li><span class="pk">Race weekend</span><span class="pd">Paddock access, grid walks and hospitality for your clients at any round.</span></li>
            <li><span class="pk">Digital</span><span class="pd">Coverage across the series channels, race reports and the season highlights.</span></li>
          </ul>
        </div>

        <form class="form" name="partner-enquiry" method="POST" data-netlify="true" netlify-honeypot="fax-number" action="/thanks/">
          <input type="hidden" name="form-name" value="partner-enquiry">
          <p class="hp"><label>Leave this empty <input name="fax-number" tabindex="-1" autocomplete="off"></label></p>

          <h3>Partner enquiry</h3>
          <p class="form__note">We come back to everyone within [two working days].</p>

          <div class="row2">
            <label class="field"><span>Name</span><input type="text" name="name" autocomplete="name" required></label>
            <label class="field"><span>Company</span><input type="text" name="company" autocomplete="organization" required></label>
          </div>
          <div class="row2">
            <label class="field"><span>Email</span><input type="email" name="email" autocomplete="email" required></label>
            <label class="field"><span>Phone</span><input type="tel" name="phone" autocomplete="tel"></label>
          </div>
          <label class="field"><span>What are you looking for</span><textarea name="message" rows="3"></textarea></label>
          <button class="btn btn--lg btn--block" type="submit">Send enquiry</button>
          <p class="form__legal">We will only use your details to answer this enquiry.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- =========================================================== media -->
  <section class="band" id="news">
    <div class="shell">
      <div class="band__head reveal">
        <div>
          <p class="eyebrow">News</p>
          <h2>From the paddock</h2>
        </div>
        <a class="lnk" href="/news/">All news</a>
      </div>
      {% set latest = collections.news | reverse | limit(3) %}
      {% if latest.length %}
      <div class="cards reveal">
        {% for post in latest %}
        <a class="card" href="{{ post.url }}">
          <div class="card__media">
            {% if post.data.image %}
              <img src="{{ post.data.image }}" alt="{{ post.data.imageAlt | default('') }}" loading="lazy">
            {% else %}
              <span class="imgph"><span>Image</span></span>
            {% endif %}
          </div>
          <p class="card__meta"><span class="card__cat">{{ post.data.category }}</span>
            <time datetime="{{ post.data.date | dateISO }}">{{ post.data.date | dateUK }}</time></p>
          <h3 class="card__title">{{ post.data.title }}</h3>
          <p class="card__excerpt">{{ post.data.excerpt }}</p>
        </a>
        {% endfor %}
      </div>
      {% else %}
      <p class="newsempty">The first race report will appear here.</p>
      {% endif %}
    </div>
  </section>
