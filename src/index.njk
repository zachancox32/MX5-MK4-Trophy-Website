---
layout: base.njk
title: "MX-5 Mk4 Trophy | One make Mazda MX-5 racing with the BRSCC"
description: "The MX-5 Mk4 Trophy runs with the BRSCC on UK circuits. Identical Mk4 Mazda MX-5s on Goodyear control slicks, sealed to the same spec. Calendar, standings and how to get a seat."
ogTitle: "MX-5 Mk4 Trophy"
ogDescription: "Same car, same tyre. Identical Mk4 Mazda MX-5s on Goodyear control slicks, racing with the BRSCC."
permalink: /index.html
---
<!-- ============================================================ hero -->
  <section class="hero">
    <div class="shell hero__in">
      <div>
        <p class="eyebrow">{{ season.year }} season &middot; BRSCC club racing</p>
        <h1>
          <span>Same car.</span>
          <span class="accent">Same tyre.</span>
        </h1>
        <p class="hero__lede">The MX-5 Mk4 Trophy runs with the BRSCC on UK circuits. Identical Mk4 Mazda MX-5s on identical Goodyear slicks, sealed to the same spec, so the result comes down to the driver.</p>
        <div class="hero__cta">
          <a class="btn btn--lg" href="#enquire">Get on the grid</a>
          <a class="btn btn--lg btn--ghost" href="#calendar">See the {{ season.year }} calendar</a>
        </div>
        <p class="credential">
          <span>Racing with</span>
          <a href="https://brscc.co.uk/" rel="noopener">
            <img src="/assets/brand/brscc-logo.png" alt="British Racing and Sports Car Club" width="300" height="76">
          </a>
        </p>
      </div>

      {% if season.rounds.length %}
      {# js/main.js fills this in from the calendar below; the markup here
         is the fallback shown if JavaScript never runs #}
      <div class="next" id="next-round" data-next-card>
        <div class="next__top">
          <p class="eyebrow" data-next-label>Next round</p>
          <span class="next__count" data-next-count hidden></span>
        </div>
        <h2 class="next__ct" data-next-circuit>The {{ season.year }} season</h2>
        <p class="next__date" data-next-date>{{ season.rounds.length }} rounds</p>
        <dl class="next__facts">
          <div><dt>Round</dt><dd class="num" data-next-index>{{ season.rounds.length }}</dd></div>
          <div><dt>Of</dt><dd class="num">{{ season.rounds.length }}</dd></div>
        </dl>
        <a class="lnk" href="#calendar">Full calendar</a>
      </div>
      {% else %}
      <div class="next next--pre">
        <div class="next__top">
          <p class="eyebrow">Season one &middot; {{ season.year }}</p>
        </div>
        <h2 class="next__ct">Entries opening soon</h2>
        <p class="next__date">Racing on the BRSCC SuperCup grid</p>
        <p class="next__pre">The {{ season.year }} calendar follows the BRSCC MX-5 SuperCup dates. It goes up here the moment they are published.</p>
        <a class="btn btn--block" href="#enquire">Register your interest</a>
      </div>
      {% endif %}
    </div>
  </section>

  <!-- ========================================================== ticker -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker__track" data-ticker>
      <span>MX-5 Mk4 Trophy</span><span>&frasl;</span>
      <span>Same car, same tyre</span><span>&frasl;</span>
      <span>Racing with the BRSCC</span><span>&frasl;</span>
      <span>MX-5 Mk4 Trophy</span><span>&frasl;</span>
      <span>Same car, same tyre</span><span>&frasl;</span>
      <span>Racing with the BRSCC</span><span>&frasl;</span>
    </div>
  </div>

  <!-- ======================================================== calendar -->
  <section class="band" id="calendar">
    <div class="shell">
      <div class="band__head reveal">
        <div>
          <p class="eyebrow">The season</p>
          <h2>{{ season.year }} calendar</h2>
        </div>
      </div>

      {% if season.rounds.length %}
      <div class="cal reveal" data-calendar>
        {% for r in season.rounds %}
        <div class="cal__row" data-round="{{ r.round }}" data-start="{{ r.start }}" data-end="{{ r.end }}"{% if loop.last %} data-finale{% endif %}>
          <span class="cal__no num">{{ "0" if r.round < 10 }}{{ r.round }}</span>
          <span class="cal__ct">{{ r.circuit }}</span>
          <span class="cal__loc">{{ r.county }}</span>
          <span class="cal__dt num">{{ r.start | dateUK }}</span>
          <span class="pill" data-status>Upcoming</span>
        </div>
        {% endfor %}
      </div>
      {% else %}
      <div class="tbc reveal">
        <p class="tbc__flag">To be confirmed</p>
        <h3 class="tbc__h">The {{ season.year }} calendar is not published yet.</h3>
        <p class="tbc__p">The Trophy runs on the BRSCC MX-5 SuperCup grid, so our dates follow theirs. As soon as the BRSCC publish the {{ season.year }} calendar it goes up here, with the countdown and round by round results running off it.</p>
        <a class="btn btn--lg" href="#enquire">Register your interest</a>
      </div>
      {% endif %}
    </div>
  </section>

  <!-- ======================================================= standings -->
  <section class="band band--dark" id="standings">
    <div class="shell">
      <div class="band__head reveal">
        <div>
          <p class="eyebrow">{% if standings.afterRound %}After {{ standings.afterRound }} of {{ standings.totalRounds }} rounds{% else %}{{ standings.season }} season{% endif %}</p>
          <h2>Championship standings</h2>
        </div>
        {% if standings.drivers.length %}<a class="lnk" href="#calendar">The calendar</a>{% endif %}
      </div>

      {% if standings.drivers.length %}
      <div class="tablewrap reveal">
        <table class="table">
          <caption class="vh">Drivers championship</caption>
          <thead>
            <tr>
              <th scope="col">Pos</th><th scope="col">No</th><th scope="col">Driver</th>
              <th scope="col">Team</th><th scope="col" style="text-align:center">Wins</th>
              <th scope="col" style="text-align:right">Pts</th>
            </tr>
          </thead>
          <tbody>
            {% for d in standings.drivers %}
            <tr>
              <td class="pos num">{{ d.pos }}</td>
              <td class="car num">{{ d.no }}</td>
              <td class="nm">{{ d.name }}</td>
              <td class="team">{{ d.team }}</td>
              <td class="w num">{{ d.wins }}</td>
              <td class="pts num">{{ d.points }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <div class="tbc tbc--dark reveal">
        <p class="tbc__flag">No results yet</p>
        <h3 class="tbc__h">The first season runs in {{ standings.season }}.</h3>
        <p class="tbc__p">Standings will appear here after round one and update after every round.</p>
        <a class="btn btn--lg" href="#enquire">Get on the grid</a>
      </div>
      {% endif %}
    </div>
  </section>

  <!-- ========================================================= the car -->
  <section class="band" id="car">
    <div class="shell">
      <div class="car reveal">
        <div>
          <p class="eyebrow" style="color:var(--red-ink);margin-bottom:9px">The car</p>
          <h2 style="font-size:clamp(27px,4.4vw,36px);margin-bottom:14px">One spec. Sealed. Scrutineered.</h2>
          <p style="color:var(--grit-2);margin:0 0 16px;max-width:46ch">Every car in the Trophy is a Mk4 Mazda MX-5 built to the same control specification, on the same Goodyear hard compound slick. No development race, no budget arms race. What you bring is setup, tyre management and the ability to overtake.</p>
          <p style="color:var(--grit-2);margin:0 0 16px;max-width:46ch">Slicks are controlled to six sets for the whole season. That caps what anyone can spend their way to, and it makes looking after a set part of the job rather than an afterthought. Qualifying on fresh rubber is a decision with a cost, not a default. A Goodyear wet is available as well, so a soaked weekend does not come out of your dry allocation.</p>
          <p style="color:var(--grit-2);margin:0 0 16px;max-width:46ch">ABS, traction control and a ZF sequential gearbox are part of that specification. The car is modern rather than raw, so a missed downshift does not end your afternoon. That makes it a realistic first car for a driver straight out of an ARDS test, and still quick enough to be worth the time of someone who has raced for years.</p>
          <p class="note">For 2027 the Trophy runs on the BRSCC MX-5 SuperCup grid, scored as its own championship. You share the track with the SuperCup Mk3 cars, but not the championship. Different car, different tyre, your own results and your own title. From 2028 the Trophy takes its own slot on the BRSCC roster.</p>
          <ul class="spec">
            <li><span class="k">Chassis</span><span class="v">Mazda MX-5 Mk4, ND</span></li>
            <li><span class="k">Engine</span><span class="v">Sealed</span></li>
            <li><span class="k">Gearbox</span><span class="v">ZF sequential</span></li>
            <li><span class="k">Driver aids</span><span class="v">ABS and traction control</span></li>
            <li><span class="k">Tyres</span><span class="v">Goodyear hard compound slick and wet</span></li>
            <li><span class="k">Allocation</span><span class="v">Six sets of slicks per season</span></li>
          </ul>
        </div>
        {# When a photo exists, replace the block below with:
           <img src="/assets/img/car-on-track.jpg" alt="An MX-5 Mk4 Trophy car on track" width="900" height="600"> #}
        <div class="imgph car__media"><span>Photo<br>Mk4 MX-5, three quarter front, on track</span></div>
      </div>
    </div>
  </section>

  <!-- ==================================================== race with us -->
  <section class="band band--dark" id="race">
    <div class="shell">
      <div class="band__head reveal">
        <div>
          <p class="eyebrow">Race with us</p>
          <h2>From licence to grid in three steps</h2>
        </div>
      </div>
      <div class="steps reveal">
        <div class="step">
          <span class="step__n">01</span>
          <h3>Get your licence</h3>
          <p>An ARDS test and an MSUK National licence. A day at a circuit, and you can book it before you have a car or a seat.</p>
        </div>
        <div class="step">
          <span class="step__n">02</span>
          <h3>Buy or hire a car</h3>
          <p>Arrive and drive for a weekend, or buy a car of your own. <a href="/teams/">Teams are being confirmed</a>, and they will give you a straight figure.</p>
        </div>
        <div class="step">
          <span class="step__n">03</span>
          <h3>Enter the season</h3>
          <p>We will walk you through the BRSCC entry paperwork and what the season asks of you.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================= driver conversion -->
  <section class="cta">
    <div class="shell cta__in">
      <div>
        <h2>Tell us where you are and we will tell you what it takes.</h2>
        <p>No obligation. A phone call, an honest budget, and an introduction to a team with a seat free.</p>
      </div>
      <a class="btn btn--lg btn--ink" href="#enquire">Enquire about a seat</a>
    </div>
  </section>

  <section class="band band--deep" id="enquire">
    <div class="shell">
      <div class="partner reveal">
        <div>
          <p class="eyebrow" style="color:var(--yellow);margin-bottom:9px">Driver enquiry</p>
          <h2 style="font-size:clamp(27px,4.4vw,36px);margin-bottom:14px">Get on the grid.</h2>
          <p style="color:#A8A89E;margin:0;max-width:46ch">Whether you already hold a licence or you have never sat in a race car, we will be straight with you about what a season costs and what it asks of you.</p>
          <p style="color:#A8A89E;margin:18px 0 0;max-width:46ch">That might mean finding your first test day, a seat for a single round, or checking a car you already own against the regulations.</p>
        </div>

        <form class="form" name="driver-enquiry" method="POST" data-netlify="true" netlify-honeypot="company-website" action="/thanks/">
          <input type="hidden" name="form-name" value="driver-enquiry">
          <p class="hp"><label>Leave this empty <input name="company-website" tabindex="-1" autocomplete="off"></label></p>

          <h3>Driver enquiry</h3>
          <p class="form__note">A person reads every enquiry and comes back to you.</p>

          <div class="row2">
            <label class="field"><span>Name</span><input type="text" name="name" autocomplete="name" required></label>
            <label class="field"><span>Phone</span><input type="tel" name="phone" autocomplete="tel"></label>
          </div>
          <label class="field"><span>Email</span><input type="email" name="email" autocomplete="email" required></label>
          <label class="field"><span>Where are you now</span>
            <select name="stage">
              <option>New to racing, no licence</option>
              <option>Doing my ARDS test</option>
              <option>Licence held, no car</option>
              <option>I have a car already</option>
            </select>
          </label>
          <label class="field"><span>Anything else</span><textarea name="message" rows="3"></textarea></label>
          <button class="btn btn--lg btn--block" type="submit">Send enquiry</button>
          <p class="form__legal">We will only use your details to answer this enquiry.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- ======================================================== partners -->
  <section class="band" id="partners">
    <div class="shell">
      <div class="band__head reveal">
        <div>
          <p class="eyebrow">Series partners</p>
          <h2>Who backs the Trophy</h2>
        </div>
        <a class="lnk" href="#partner-enquiry">Partner with us</a>
      </div>

      <div class="plogos reveal">
        <a class="ptile" href="https://www.goodyear.eu/en_gb/consumer.html" rel="noopener">
          <img src="/assets/brand/partners/goodyear-blue.png" alt="Goodyear, championship tyre partner"
               width="760" height="228" loading="lazy">
        </a>
        <a class="ptile" href="https://www.thermalroadrepairs.com/" rel="noopener">
          <img src="/assets/brand/partners/thermal-road-repairs.png" alt="Thermal Road Repairs"
               width="1749" height="630" loading="lazy">
        </a>
        <a class="ptile" href="https://www.admodular.com/" rel="noopener">
          <img class="is-tall" src="/assets/brand/partners/ad-modular.png" alt="AD Modular"
               width="300" height="147" loading="lazy">
        </a>
        <a class="ptile ptile--open" href="#partner-enquiry"><b>This space<br>is available</b></a>
      </div>
    </div>
  </section>

  <section class="band band--dark" id="partner-enquiry">
    <div class="shell">
      <div class="partner reveal">
        <div>
          <p class="eyebrow" style="color:var(--yellow);margin-bottom:9px">Partner with us</p>
          <h2 style="font-size:clamp(27px,4.4vw,36px);margin-bottom:14px">Put your brand on the grid.</h2>
          <p style="color:#A8A89E;margin:0;max-width:46ch">A season of BRSCC race weekends, in front of a paddock that buys from itself. Tell us what you want out of it and we will build the package around that rather than sell you a tier.</p>
          <p style="color:#A8A89E;margin:18px 0 0;max-width:46ch">Car livery, series rights, race weekend hospitality or digital coverage. Tell us which of those matters to you and we will come back with something costed.</p>
        </div>

        <form class="form" name="partner-enquiry" method="POST" data-netlify="true" netlify-honeypot="fax-number" action="/thanks/">
          <input type="hidden" name="form-name" value="partner-enquiry">
          <p class="hp"><label>Leave this empty <input name="fax-number" tabindex="-1" autocomplete="off"></label></p>

          <h3>Partner enquiry</h3>
          <p class="form__note">A person reads every enquiry and comes back to you.</p>

          <div class="row2">
            <label class="field"><span>Name</span><input type="text" name="name" autocomplete="name" required></label>
            <label class="field"><span>Company</span><input type="text" name="company" autocomplete="organization" required></label>
          </div>
          <div class="row2">
            <label class="field"><span>Email</span><input type="email" name="email" autocomplete="email" required></label>
            <label class="field"><span>Phone</span><input type="tel" name="phone" autocomplete="tel"></label>
          </div>
          <label class="field"><span>What are you looking for</span><textarea name="message" rows="3"></textarea></label>
          <button class="btn btn--lg btn--block" type="submit">Send enquiry</button>
          <p class="form__legal">We will only use your details to answer this enquiry.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- =========================================================== media -->
  <section class="band" id="news">
    <div class="shell">
      <div class="band__head reveal">
        <div>
          <p class="eyebrow">News</p>
          <h2>From the paddock</h2>
        </div>
        <a class="lnk" href="/news/">All news</a>
      </div>
      {% import "card-art.njk" as art %}
      {% set latest = collections.news | reverse | limit(3) %}
      {% if latest.length %}
      <div class="cards reveal">
        {% for post in latest %}
        <a class="card" href="{{ post.url }}">
          <div class="card__media">
            {% if post.data.image %}
              <img src="{{ post.data.image }}" alt="{{ post.data.imageAlt | default('') }}" loading="lazy">
            {% else %}
              {{ art.art(post.data.title, post.data.category) }}
            {% endif %}
          </div>
          <p class="card__meta"><span class="card__cat">{{ post.data.category }}</span>
            <time datetime="{{ post.data.date | dateISO }}">{{ post.data.date | dateUK }}</time></p>
          <h3 class="card__title">{{ post.data.title }}</h3>
          <p class="card__excerpt">{{ post.data.excerpt }}</p>
        </a>
        {% endfor %}
      </div>
      {% else %}
      <p class="newsempty">The first race report will appear here.</p>
      {% endif %}
    </div>
  </section>
