<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
{% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">

<meta property="og:type" content="website">
<meta property="og:site_name" content="MX-5 Mk4 Trophy">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ ogDescription or description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="https://www.mx5cupgb.co.uk/assets/brand/og-image.png">
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,400..900;1,62..125,400..900&family=Barlow:ital,wght@0,400;0,500;0,600;0,700;1,600&family=Barlow+Semi+Condensed:ital,wght@0,400;0,500;0,600;0,700&display=swap">
<link rel="stylesheet" href="/css/style.css">

{% if page.url == "/" %}{% include "jsonld.njk" %}{% endif %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

{% include "nav.njk" %}

<main id="main">
{{ content | safe }}
</main>

{% include "partners-bar.njk" %}

{% include "foot.njk" %}

<script src="/js/main.js" defer></script>
</body>
</html>
